{
  "name": "aiology-motion-studio",
  "version": "1.0.0",
  "description": "AIOLOGY Arabic educational motion graphics studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/taherfarg/aiology-motion-studio.git",
    "directory": "aiology-motion-studio"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/cairo": "5.3.0",
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/media-utils": "4.0.534",
    "lucide-react": "1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/node": "26.6.4",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "tsx scripts/verify-environment.ts",
    "episode:new": "tsx scripts/episode.ts new",
    "episode:validate": "tsx scripts/episode.ts validate",
    "episode:prepare": "tsx scripts/episode.ts prepare",
    "episode:preview": "tsx scripts/episode.ts preview",
    "episode:render": "tsx scripts/episode.ts render",
    "render:test": "remotion render src/index.ts TechnicalCheck output/technical-check.mp4 --codec=h264 --audio-codec=aac --crf=18 --pixel-format=yuv420p",
    "render:episode-001-preview": "remotion render src/index.ts Episode001Preview output/episode-001/aiology-episode-001-silent-v2.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "captions:episode-001-preview": "tsx scripts/preview-subtitles.ts",
    "render:episode-001-director": "remotion render src/index.ts Episode001DirectorCut output/episode-001/aiology-episode-001-director-v5.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "skill:install": "pwsh -NoProfile -File scripts/install-skill.ps1",
    "upgrade": "remotion upgrade",
    "audio:probe": "tsx scripts/probe-audio.ts",
    "export:check": "tsx scripts/check-export.ts",
    "skills:verify": "node scripts/verify-skill-discovery.mjs"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "overrides": {
    "typescript-eslint": "8.71.1"
  }
}
